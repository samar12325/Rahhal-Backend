generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                 BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  name               String               @db.VarChar(120)
  email              String               @unique(map: "uq_users_email") @db.VarChar(190)
  passwordHash       String               @map("password_hash") @db.VarChar(255)
  phone              String?              @db.VarChar(30)
  role               UserRole             @default(user)
  email_verified_at  DateTime?            @db.Timestamp(0)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamp(0)
  updated_at         DateTime?            @db.Timestamp(0)
  bookings           bookings[]
  group_trip_details group_trip_details[]
  reviews            reviews[]
  trips              trips[]

  @@map("users")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bookings {
  id            BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  trip_id       BigInt          @db.UnsignedBigInt
  user_id       BigInt          @db.UnsignedBigInt
  persons_count Int             @db.UnsignedInt
  total_price   Decimal         @default(0.00) @db.Decimal(10, 2)
  status        bookings_status @default(pending)
  created_at    DateTime        @default(now()) @db.Timestamp(0)
  updated_at    DateTime?       @db.Timestamp(0)
  trips         trips           @relation(fields: [trip_id], references: [id], map: "fk_bookings_trip")
  users         User            @relation(fields: [user_id], references: [id], map: "fk_bookings_user")
  payments      payments[]
  reviews       reviews?

  @@index([status], map: "idx_bookings_status")
  @@index([trip_id], map: "idx_bookings_trip")
  @@index([user_id], map: "idx_bookings_user")
}

model destinations {
  id          BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  name        String              @db.VarChar(120)
  region      destinations_region
  description String?             @db.Text
  image_url   String?             @db.VarChar(500)
  is_active   Boolean             @default(true)
  created_at  DateTime            @default(now()) @db.Timestamp(0)
  updated_at  DateTime?           @db.Timestamp(0)
  trips       trips[]

  @@unique([name, region], map: "uq_destinations_name_region")
  @@index([is_active], map: "idx_destinations_active")
  @@index([region], map: "idx_destinations_region")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model group_trip_details {
  trip_id               BigInt    @id @db.UnsignedBigInt
  required_participants Int       @db.UnsignedInt
  organizer_id          BigInt    @db.UnsignedBigInt
  join_deadline         DateTime? @db.Date
  notes                 String?   @db.Text
  created_at            DateTime  @default(now()) @db.Timestamp(0)
  updated_at            DateTime? @db.Timestamp(0)
  users                 User      @relation(fields: [organizer_id], references: [id], map: "fk_group_trip_organizer")
  trips                 trips     @relation(fields: [trip_id], references: [id], onDelete: Cascade, map: "fk_group_trip_trip")

  @@index([organizer_id], map: "idx_group_organizer")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payments {
  id              BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  booking_id      BigInt          @db.UnsignedBigInt
  amount          Decimal         @db.Decimal(10, 2)
  method          payments_method
  status          payments_status
  provider_txn_id String?         @db.VarChar(120)
  paid_at         DateTime?       @db.Timestamp(0)
  created_at      DateTime        @default(now()) @db.Timestamp(0)
  bookings        bookings        @relation(fields: [booking_id], references: [id], map: "fk_payments_booking")

  @@index([booking_id], map: "idx_payments_booking")
  @@index([method], map: "idx_payments_method")
  @@index([status], map: "idx_payments_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reviews {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  booking_id BigInt   @unique(map: "uq_reviews_booking") @db.UnsignedBigInt
  user_id    BigInt   @db.UnsignedBigInt
  rating     Int      @db.UnsignedTinyInt
  comment    String?  @db.Text
  created_at DateTime @default(now()) @db.Timestamp(0)
  bookings   bookings @relation(fields: [booking_id], references: [id], map: "fk_reviews_booking")
  users      User     @relation(fields: [user_id], references: [id], map: "fk_reviews_user")

  @@index([rating], map: "idx_reviews_rating")
  @@index([user_id], map: "idx_reviews_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model school_trip_details {
  trip_id           BigInt    @id @db.UnsignedBigInt
  school_name       String    @db.VarChar(200)
  education_level   String?   @db.VarChar(80)
  students_count    Int       @db.UnsignedInt
  supervisors_count Int       @default(0) @db.UnsignedInt
  transport_type    String?   @db.VarChar(80)
  meeting_point     String?   @db.VarChar(250)
  permit_file_url   String?   @db.VarChar(500)
  notes             String?   @db.Text
  created_at        DateTime  @default(now()) @db.Timestamp(0)
  updated_at        DateTime? @db.Timestamp(0)
  trips             trips     @relation(fields: [trip_id], references: [id], onDelete: Cascade, map: "fk_school_trip_trip")
}

model tags {
  id         BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  name       String      @unique(map: "uq_tags_name") @db.VarChar(60)
  created_at DateTime    @default(now()) @db.Timestamp(0)
  trip_tags  trip_tags[]
}

model trip_tags {
  trip_id    BigInt   @db.UnsignedBigInt
  tag_id     BigInt   @db.UnsignedBigInt
  created_at DateTime @default(now()) @db.Timestamp(0)
  tags       tags     @relation(fields: [tag_id], references: [id], map: "fk_trip_tags_tag")
  trips      trips    @relation(fields: [trip_id], references: [id], onDelete: Cascade, map: "fk_trip_tags_trip")

  @@id([trip_id, tag_id])
  @@index([tag_id], map: "idx_trip_tags_tag")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model trips {
  id                  BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  title               String               @db.VarChar(180)
  destination_id      BigInt               @db.UnsignedBigInt
  type                trips_type           @default(individual)
  description         String?              @db.Text
  start_date          DateTime?            @db.Date
  end_date            DateTime?            @db.Date
  duration_days       Int?                 @db.UnsignedInt
  price_per_person    Decimal?             @db.Decimal(10, 2)
  max_participants    Int?                 @db.UnsignedInt
  status              trips_status         @default(draft)
  created_by          BigInt               @db.UnsignedBigInt
  created_at          DateTime             @default(now()) @db.Timestamp(0)
  updated_at          DateTime?            @db.Timestamp(0)
  bookings            bookings[]
  group_trip_details  group_trip_details?
  school_trip_details school_trip_details?
  trip_tags           trip_tags[]
  users               User                 @relation(fields: [created_by], references: [id], map: "fk_trips_creator")
  destinations        destinations         @relation(fields: [destination_id], references: [id], map: "fk_trips_destination")

  @@index([created_by], map: "idx_trips_created_by")
  @@index([start_date, end_date], map: "idx_trips_dates")
  @@index([destination_id], map: "idx_trips_destination")
  @@index([type, status], map: "idx_trips_type_status")
}

enum UserRole {
  user
  admin
}

enum destinations_region {
  central
  west
  east
  north
  south
}

enum payments_method {
  card
  applepay
  stcpay
  cash
}

enum trips_type {
  individual
  group
  school
  ai
}

enum payments_status {
  paid
  failed
  refunded
}

enum bookings_status {
  pending
  confirmed
  cancelled
  completed
}

enum trips_status {
  draft
  open
  full
  completed
  cancelled
}
